# =============================================================================
# DevStory AI — .gitignore
# =============================================================================

# Entorno y Secretos (CRÍTICO: nunca subir credenciales)
.env
.env.*
.env.local
.env.*.local
backend/.env
frontend/.env.local
**/.env
**/.env.local

# Permitir explícitamente las plantillas .example
!.env.example
!.env.local.example
!**/.env.example
!**/.env.local.example

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Python Virtual Environments
.venv/
venv/
env/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
.npm
.eslintcache

# Documentos pesados de oficina (mantener repo limpio)
*.pdf
*.docx
*.pptx
*.xlsx

# Archivos de Sistema Operativo e IDEs
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
