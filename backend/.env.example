# --- Google Gemini ---
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_PRO=gemini-3.8-pro

# --- Supabase (server-side only, never expose the service role key) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE
SUPABASE_STORAGE_BUCKET=sketches_audio

# --- API ---
ALLOWED_ORIGINS=http://localhost:3000,https://devstory.app
MAX_UPLOAD_MB=10
ENVIRONMENT=development
